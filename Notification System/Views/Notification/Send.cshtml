@{
    var message = ViewBag.Message as string;
    var error = ViewBag.Error as string;
}

<style>
    body {
        background: linear-gradient(135deg, #6ee7b7, #a5b4fc, #c4b5fd);
        background-size: 200% 200%;
        animation: bgmove 12s ease infinite;
        min-height: 100vh;
        color: #1f2937;
    }

    @@keyframes bgmove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .soft-card {
        background: rgba(255,255,255,0.75);
        backdrop-filter: blur(12px);
        border-radius: 22px;
        border: 1px solid rgba(255,255,255,0.5);
        box-shadow: 0 25px 60px rgba(0,0,0,0.15);
    }

    .soft-header {
        border-radius: 22px 22px 0 0;
        background: linear-gradient(135deg, #6366f1, #14b8a6);
        color: white;
        padding: 24px;
        text-align: center;
        font-size: 1.3rem;
        font-weight: 600;
    }

    .form-control, .form-select {
        border-radius: 12px;
        padding: 14px;
        border: 1px solid #e5e7eb;
        background: rgba(255,255,255,0.9);
    }

        .form-control:focus, .form-select:focus {
            border-color: #818cf8;
            box-shadow: 0 0 0 3px rgba(129,140,248,.25);
            background: white;
        }

    .label-soft {
        font-size: 0.85rem;
        font-weight: 600;
        color: #4b5563;
        margin-bottom: 6px;
    }

    .btn-soft {
        border-radius: 14px;
        padding: 16px;
        font-weight: 600;
        background: linear-gradient(135deg, #6366f1, #14b8a6);
        border: none;
        color: white;
        font-size: 1.05rem;
    }

        .btn-soft:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(99,102,241,.35);
        }

    .alert {
        border-radius: 12px;
        font-weight: 500;
    }
</style>

<div class="container d-flex align-items-center justify-content-center" style="min-height:100vh;">
    <div class="col-md-7 col-lg-6">

        <div class="card soft-card">

            <div class="soft-header">
                Notification System
            </div>

            <div class="card-body p-4">

                <form method="post">

                    <div class="mb-3">
                        <div class="label-soft">Notification Type</div>
                        <select id="notificationType"
                                name="notificationType"
                                class="form-select"
                                required
                                onchange="updateRecipientPlaceholder()">
                            <option value="Email"> Email</option>
                            <option value="SMS"> SMS</option>
                            <option value="Push"> Push</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="label-soft">Recipient</div>
                        <input type="text"
                               id="recipient"
                               name="recipient"
                               class="form-control"
                               placeholder="email@example.com"
                               required />
                    </div>

                    <div class="mb-3">
                        <div class="label-soft">Title</div>
                        <input type="text"
                               name="title"
                               class="form-control"
                               placeholder="Notification title"
                               required />
                    </div>

                    <div class="mb-4">
                        <div class="label-soft">Message</div>
<textarea name="message"
          rows="4"
          class="form-control"
          placeholder="Type your message..."
          required></textarea>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-soft">
                            Send Notification
                        </button>
                    </div>

                </form>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="alert alert-success mt-4 text-center">@message</div>
                }

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger mt-4 text-center">@error</div>
                }

            </div>
        </div>
    </div>

</div>

<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-messaging-compat.js"></script>

<script>
        const firebaseConfig = {
          apiKey: "AIzaSyAZZhAYEmdyuPWCB-14D1Vq9y7OUzBcnVA",
          authDomain: "notifications-68720.firebaseapp.com",
          projectId: "notifications-68720",
          storageBucket: "notifications-68720.firebasestorage.app",
          messagingSenderId: "882368994384",
          appId: "1:882368994384:web:b68bca730dcf79d2734555"
        };

        firebase.initializeApp(firebaseConfig);
        const messaging = firebase.messaging();

        if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/firebase-messaging-sw.js');
    }

        async function getDeviceToken() {
            try {
                const permission = await Notification.requestPermission();
                if (permission !== "granted") {
                    alert("Push permission denied");
                    return;
                }

                const token = await messaging.getToken({
                    vapidKey: "BI5d-Na7Ul4Xy0_noBksNKeYIpdN0j8RSDc2aW0Ovl1uxftk7JzzXjI23x-CdfYPZJ5HS2tlkiS_pXmAkvs1uuI"
                });

                console.log("Device token:", token);
                document.getElementById("recipient").value = token;

            } catch (err) {
                console.error(err);
                alert("Failed to get device token");
            }
        }

        function updateRecipientPlaceholder() {
            const type = document.getElementById("notificationType").value;
            const recipient = document.getElementById("recipient");

            if (type === "Email") {
                recipient.placeholder = "email@example.com";
                recipient.value = "";
            }
            else if (type === "SMS") {
                recipient.placeholder = "+27786123456";
                recipient.value = "";
            }
            else if (type === "Push") {
                recipient.placeholder = "Auto-generated device token";
                getDeviceToken();
            }
        }

            messaging.onMessage((payload) => {
            console.log("Push received:", payload);
            alert(payload.notification.title + " — " + payload.notification.body);
        });

</script>
